{{- $pages := .Site.RegularPages.ByPublishDate.Reverse | first 20 -}}
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ .Site.Title | htmlEscape }}</title>
  <link href="{{ "atom.xml" | absURL | htmlEscape }}" rel="self" type="application/atom+xml"/>
  <link href="{{ .Site.BaseURL | htmlEscape }}" rel="alternate" type="text/html"/>
  <id>{{ .Site.BaseURL | htmlEscape }}</id>
  <updated>{{ now.Format "2006-01-02T15:04:05Z07:00" }}</updated>
  <author><name>{{ .Site.Params.author | htmlEscape }}</name></author>
  {{ range $pages }}
  <entry>
    <title>{{ .Title | htmlEscape }}</title>
    <link href="{{ .Permalink | htmlEscape }}" rel="alternate" type="text/html"/>
    <id>{{ .Permalink | htmlEscape }}</id>
    <updated>{{ .Lastmod.Format "2006-01-02T15:04:05Z07:00" }}</updated>
    <published>{{ .PublishDate.Format "2006-01-02T15:04:05Z07:00" }}</published>
    {{ range .Params.tags }}<category term="{{ . | htmlEscape }}"/>
    {{ end }}<content type="html">{{ .Content | htmlEscape }}</content>
  </entry>
  {{ end }}
</feed>
